<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+. Same choices as backup_rules.xml: only the
   expense database, never preferences (device ID) or Firebase sign-in state. Cloud backups are
   skipped on devices that can't encrypt them end to end, since this is financial data.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="spendwise.db" />
        <include domain="database" path="spendwise.db-wal" />
        <include domain="database" path="spendwise.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spendwise.db" />
        <include domain="database" path="spendwise.db-wal" />
        <include domain="database" path="spendwise.db-shm" />
    </device-transfer>
</data-extraction-rules>

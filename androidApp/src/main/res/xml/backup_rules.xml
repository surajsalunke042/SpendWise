<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup on Android 11 and lower (see data_extraction_rules.xml for 12+).
   Only the expense database is backed up. Preferences are left out on purpose: they hold the
   per-install device ID used for sync conflict resolution, which must not be cloned onto a new
   device. Firebase's own files are left out too, so a restore never brings back a signed-in session.
-->
<full-backup-content>
    <include domain="database" path="spendwise.db" />
    <include domain="database" path="spendwise.db-wal" />
    <include domain="database" path="spendwise.db-shm" />
</full-backup-content>

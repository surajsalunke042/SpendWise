rules_version = '2';

// Each user can only read and write their own data: users/{uid}/expenses and users/{uid}/categories.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validCommon(data) {
      return data.id is string && data.id.size() <= 64
        && data.updatedAt is int
        && data.lastModifiedBy is string
        && data.serverUpdatedAt == request.time;
    }

    match /users/{uid}/expenses/{expenseId} {
      allow read: if isOwner(uid);
      // Hard deletes only happen when the user deletes their account.
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.id == expenseId
        && validCommon(request.resource.data)
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor >= 0
        && request.resource.data.currency is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500;
    }

    match /users/{uid}/categories/{categoryId} {
      allow read: if isOwner(uid);
      // Hard deletes only happen when the user deletes their account.
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.id == categoryId
        && validCommon(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
